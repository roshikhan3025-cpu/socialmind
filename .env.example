# SocialMind Environment Variables
# Copy this file to .env and fill in the values

# AI API key (used server-side only)
FOUREVERLAND_API_KEY=your_4everland_api_key

# Auth secret for JWT signing (generate with: openssl rand -hex 32)
AUTH_SECRET=your_random_secret_here

# Neon Postgres (https://console.neon.tech -> Connection Details -> Connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# App URL (used for OAuth redirect URIs)
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Zernio API — social media OAuth + posting for all platforms
# Get your key at https://zernio.com/settings/api-keys
ZERNIO_API_KEY=sk_your_zernio_api_key_here
